# Default: ask the router to map UDP 47322 with UPnP.
QORTAL_MASQUE_RELAY_PORT=47322
QORTAL_MASQUE_UPNP=true

# For manual port forwarding, set a literal public IP and port, then set
# QORTAL_MASQUE_UPNP=false. Domain names are not accepted.
QORTAL_MASQUE_PUBLIC_ADDRESS=

QORTAL_MASQUE_SERVER_NAME=qortal-masque-relay
QORTAL_MASQUE_MAX_SESSIONS=256
QORTAL_MASQUE_RNS_CONFIG=./reticulum.conf

# Optional exact private/loopback UDP exceptions, separated by commas.
# Public backend endpoints work without configuration.
# Example for an intentionally co-hosted service: 127.0.0.1:9000
QORTAL_MASQUE_ALLOWED_TARGETS=
